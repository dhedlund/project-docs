## ─────────────────────────────────────────────────────────────────────────
## Docs CI — EXAMPLE / TEMPLATE (inert by default)
##
## This file ends in `.yml.example`, so GitHub Actions does NOT run it.
## To enable it:
##   1. Rename it to `docs-ci.yml` (drop `.example`).
##   2. Adjust the trigger `paths:` and `working-directory` for your repo layout.
##   3. Commit. It will run on push / PR.
##
## It builds the docs the SAME way you do locally — through the toolkit image — so
## the image-baked build hook (status badges + "Used by" backlinks) and the
## `docs-check` linter are present. A broken link, invalid nav, or frontmatter
## error fails the PR.
## ─────────────────────────────────────────────────────────────────────────

name: docs-ci

on:
  push:
    branches: [main]
    paths: ["docs/**", "mkdocs.yml", "requirements.txt", "Containerfile", "tools/**"]
  pull_request:
    paths: ["docs/**", "mkdocs.yml", "requirements.txt", "Containerfile", "tools/**"]

jobs:
  build:
    runs-on: ubuntu-latest
    # If this repo lives in a monorepo subdirectory, set the path here (and update
    # the `paths:` above to match).
    # defaults:
    #   run:
    #     working-directory: project-docs
    steps:
      - uses: actions/checkout@v4

      # GitHub runners ship Docker; the Containerfile is OCI-standard.
      - name: Build toolkit image
        run: docker build -t docs-toolkit -f Containerfile .

      - name: Build site (offline, strict)
        run: docker run --rm --network none -v "$PWD":/docs -w /docs docs-toolkit mkdocs build --strict

      - name: Lint frontmatter + cross-links
        run: docker run --rm --network none -v "$PWD":/docs -w /docs docs-toolkit docs-check docs

      - name: Test the tools
        run: docker run --rm --network none -v "$PWD":/docs -w /docs docs-toolkit python -m pytest tools/tests -q

  # ── Optional / future steps ────────────────────────────────────────────────
  #
  # Coverage / staleness report (informational):
  #   - run: docker run --rm --network none -v "$PWD":/docs -w /docs docs-toolkit docs-report docs
  #
  # Drift vs the source repos (needs the code clones mounted — see
  # agent_docs/stewardship/source-of-truth.md):
  #   - run: docker run --rm -v "$PWD":/docs -v /path/to/code:/src:ro -w /docs docs-toolkit docs-drift docs
  #
  # Publish to GitHub Pages (after `permissions: pages: write` + Pages config):
  #   - uses: actions/upload-pages-artifact@v3
  #     with: { path: site }
  #   - uses: actions/deploy-pages@v4
